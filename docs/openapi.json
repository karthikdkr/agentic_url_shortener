{
  "components": {
    "schemas": {
      "AnalyticsResponse": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "daily": {
            "items": {
              "$ref": "#/components/schemas/DailyClickCount"
            },
            "title": "Daily",
            "type": "array"
          },
          "top_referrers": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Top Referrers",
            "type": "array"
          },
          "total_clicks": {
            "title": "Total Clicks",
            "type": "integer"
          }
        },
        "required": [
          "code",
          "total_clicks",
          "daily",
          "top_referrers"
        ],
        "title": "AnalyticsResponse",
        "type": "object"
      },
      "ApprovalRequest": {
        "properties": {
          "approved": {
            "title": "Approved",
            "type": "boolean"
          },
          "note": {
            "default": "",
            "maxLength": 2000,
            "title": "Note",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "reviewer": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Reviewer",
            "type": "string"
          }
        },
        "required": [
          "approved",
          "reviewer"
        ],
        "title": "ApprovalRequest",
        "type": "object"
      },
      "CreateURLRequest": {
        "properties": {
          "custom_alias": {
            "anyOf": [
              {
                "maxLength": 32,
                "minLength": 4,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Alias"
          },
          "expires_in_days": {
            "anyOf": [
              {
                "maximum": 3650.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires In Days"
          },
          "url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "CreateURLRequest",
        "type": "object"
      },
      "DailyClickCount": {
        "properties": {
          "clicks": {
            "title": "Clicks",
            "type": "integer"
          },
          "date": {
            "title": "Date",
            "type": "string"
          }
        },
        "required": [
          "date",
          "clicks"
        ],
        "title": "DailyClickCount",
        "type": "object"
      },
      "EngineeringRunRequest": {
        "properties": {
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "requirement": {
            "maxLength": 10000,
            "minLength": 10,
            "title": "Requirement",
            "type": "string"
          },
          "scenario_type": {
            "default": "greenfield",
            "enum": [
              "greenfield",
              "brownfield",
              "ambiguous"
            ],
            "title": "Scenario Type",
            "type": "string"
          }
        },
        "required": [
          "requirement"
        ],
        "title": "EngineeringRunRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ReplanRequest": {
        "properties": {
          "changed_requirement": {
            "maxLength": 10000,
            "minLength": 10,
            "title": "Changed Requirement",
            "type": "string"
          },
          "reason": {
            "maxLength": 1000,
            "minLength": 3,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "changed_requirement",
          "reason"
        ],
        "title": "ReplanRequest",
        "type": "object"
      },
      "URLResponse": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "disabled": {
            "title": "Disabled",
            "type": "boolean"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "short_url": {
            "title": "Short Url",
            "type": "string"
          },
          "target_url": {
            "title": "Target Url",
            "type": "string"
          }
        },
        "required": [
          "code",
          "target_url",
          "short_url",
          "created_at",
          "expires_at",
          "disabled"
        ],
        "title": "URLResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
